# =========================================================
# MesaFácil - variáveis de ambiente
# Copie este arquivo para ".env" (na pasta backend/) e ajuste os valores.
# NUNCA versione o arquivo .env real.
# =========================================================

# Banco de dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mesafacil
DB_USER=root
DB_PASSWORD=troque-esta-senha

# Autenticação (JWT)
JWT_SECRET=troque-este-segredo-por-uma-string-aleatoria-longa
JWT_EXPIRATION_MINUTES=480

# Servidor
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=true

# URL base usada para montar o link contido no QR Code de cada mesa
APP_BASE_URL=http://localhost:5000

# Senhas dos usuários de teste criados por backend/seed.py
SEED_ADMIN_PASSWORD=admin123
SEED_CAIXA_PASSWORD=caixa123
SEED_COZINHA_PASSWORD=cozinha123
